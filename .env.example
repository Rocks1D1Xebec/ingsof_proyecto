# =====================================================================
# EduAsistente — PLANTILLA DE CONFIGURACIÓN
# =====================================================================
#
# CÓMO USAR:
#   1. Copia este archivo como ".env" en la raíz del proyecto.
#   2. Rellena los valores reales.
#   3. ".env" está en .gitignore: NUNCA se sube al repositorio.
#
# En Render (producción) NO se usa este archivo: las variables se
# configuran en el panel: Render > tu servicio > Environment.
#
# IMPORTANTE: este archivo solo tiene valores de EJEMPLO.
# No escribas aquí credenciales reales: la plantilla se versiona en Git.
# =====================================================================


# ---------------------------------------------------------------------
# 1) CLOUDFLARE D1 — base de datos (SQLite) con los metadatos
# ---------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID:
#   Cloudflare > panel lateral > "Account ID" (o en la URL del dashboard).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# CLOUDFLARE_DATABASE_ID:
#   Cloudflare > Workers & Pages > D1 > tu base de datos > "Database ID".
CLOUDFLARE_DATABASE_ID=your-d1-database-id

# CLOUDFLARE_API_TOKEN:
#   Cloudflare > perfil > API Tokens > "Create Token".
#   Permisos requeridos: Account > D1 Database > Edit.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token


# ---------------------------------------------------------------------
# 2) CLOUDFLARE R2 — almacenamiento FÍSICO de los archivos
# ---------------------------------------------------------------------
# R2_BUCKET_NAME:
#   Cloudflare > R2 Object Storage > el bucket que crees (ej. "eduasistente-archivos").
R2_BUCKET_NAME=your-bucket-name

# R2_ACCESS_KEY_ID y R2_SECRET_ACCESS:
#   Cloudflare > R2 Object Storage > "Manage R2 API Tokens" > crear token.
#   Estos NO son las credenciales de la cuenta: son claves específicas de R2.
#   Permisos del token: Object Read & Write, ybucketed en el bucket de arriba.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS=your-r2-secret-access-key

# R2_ENDPOINT:
#   URL del endpoint S3 compatible de tu cuenta.
#   Formato: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Si lo dejas vacío, el código lo arma con CLOUDFLARE_ACCOUNT_ID.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com


# ---------------------------------------------------------------------
# 3) GOOGLE GEMINI — inteligencia artificial (chat, imágenes, ejercicios)
# ---------------------------------------------------------------------
# Salida de https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key


# ---------------------------------------------------------------------
# 4) SESIÓN DE FLASK — firma las cookies de sesión
# ---------------------------------------------------------------------
# Cadena larga y aleatoria. NUNCA la reutilices entre entornos.
# Cómo generarla (PowerShell):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-cadena-por-una-larga-y-aleatoria


# =====================================================================
# NOTAS
# =====================================================================
# * El bucket de R2 debe existir ANTES de subir el primer archivo.
# * R2 tiene coste por almacenamiento y por salida. Vigila las cargas.
# * Formatos de archivo admitidos por la app: PNG, JPG, JPEG, WEBP, GIF y PDF.
# * Límite actual por archivo: 10 MB.
# =====================================================================
