# --- Secretos y variables de entorno ---------------------------------
# CRÍTICO: .env contiene CLOUDFLARE_API_TOKEN y las credenciales de R2.
# NUNCA commitearlo. El repositorio es público.
.env
.env.*
# Excepción: la plantilla de configuración sí se versiona.
!.env.example

# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# --- Pruebas / cobertura ----------------------------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Sistema operativo / editores -------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- Notas de trabajo temporales --------------------------------------
*.tmp
*.bak
*.log
