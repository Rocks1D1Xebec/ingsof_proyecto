        <mxCell id="cu" value="Registrar Cuenta de Usuario" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="250" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="actor" target="cu" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Pasos -->
        <mxCell id="pasos" value="&lt;b&gt;Flujo Principal:&lt;/b&gt;&lt;br&gt;1. Ingresa a la página y pulsa &quot;Crear Cuenta&quot;&lt;br&gt;2. Sistema muestra formulario (Nombre, Email, Contraseña)&lt;br&gt;3. Usuario ingresa datos y presiona &quot;Registrarse&quot;&lt;br&gt;4. Sistema valida campos&lt;br&gt;5. Sistema registra cuenta en BD&lt;br&gt;6. Sistema confirma e inicia sesión automáticamente" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="270" y="430" width="610" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pre" value="&lt;b&gt;Precondiciones:&lt;/b&gt; Conexión a internet, acceso al sistema desde celular" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="270" y="560" width="610" height="30" as="geometry" />
        </mxCell>
        <mxCell id="post" value="&lt;b&gt;Postcondiciones:&lt;/b&gt; Cuenta registrada y usuario autenticado" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="270" y="600" width="610" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

