        <!-- Flujo correcto -->
        <mxCell id="fc" value="&lt;b&gt;Flujo Principal (Respuesta Correcta):&lt;/b&gt;&lt;br&gt;1. Sistema valida que el resultado es correcto&lt;br&gt;2. Muestra mensaje motivador y resumen del procedimiento&lt;br&gt;3. Ofrece opción de otro ejercicio o regresar al menú" style="text;html=1;strokeColor=#228B22;fillColor=#E0FFE0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="270" y="430" width="320" height="80" as="geometry" />
        </mxCell>
        <!-- Flujo con errores -->
        <mxCell id="fe" value="&lt;b&gt;Flujo Secundario (Respuesta con Errores):&lt;/b&gt;&lt;br&gt;1. Sistema detecta el fallo en la respuesta&lt;br&gt;2. Muestra retroalimentación formativa:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Dónde estuvo el error (ej: &quot;Te equivocaste en el signo&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Respuesta correcta explicada paso a paso&lt;br&gt;3. Ofrece opción de intentar otro ejercicio similar" style="text;html=1;strokeColor=#CC0000;fillColor=#FFE0E0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10" vertex="1" parent="1">
